
<?xml version="1.0" encoding="UTF-8"?>

<widget
    id="com.keshan.fungamev2"
    version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <name>KESHAN FUN GAME V2</name>

    <description>
        Black and Red Neon Block Puzzle Game
    </description>

    <author>
        KESHAN
    </author>

    <content src="index.html" />

    <access origin="*" />

    <preference
        name="Orientation"
        value="portrait" />

    <preference
        name="Fullscreen"
        value="true" />

    <preference
        name="DisallowOverscroll"
        value="true" />

    <platform name="android">

        <preference
            name="AndroidXEnabled"
            value="true" />

    </platform>

</widget>
